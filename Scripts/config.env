# Static app identity, rendered once at scaffold time.
# Versioning lives in ../version.env. Signing/notary secrets come from the
# environment (never from this file).
APP_NAME=Scheduler
APP_DISPLAY="Scheduler"
BUNDLE_ID=com.iannuttall.scheduler
TEAM_ID=
MIN_MACOS=14.0
FEED_URL=https://raw.githubusercontent.com/iannuttall/scheduler/main/appcast.xml
DOWNLOAD_URL_PREFIX=https://github.com/iannuttall/scheduler/releases/download/
SPARKLE_PUBLIC_KEY=
GH_OWNER=iannuttall
GH_REPO=scheduler
HOMEBREW_TAP=iannuttall/homebrew-tap
